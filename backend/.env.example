NODE_ENV=production
PORT=8100
HOST=0.0.0.0

DATABASE_URL=mysql://user:password@mysql-example.alwaysdata.net:3306/database_name
DB_HOST=mysql-example.alwaysdata.net
DB_PORT=3306
DB_USER=user
DB_PASS=password
DB_NAME=database_name
DB_CONNECTION_LIMIT=10

JWT_SECRET=replace-with-a-long-random-secret

# Email verification (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Grindly <no-reply@your-verified-domain.com>
# Optional legacy sender name; EMAIL_FROM takes precedence.
RESET_EMAIL_FROM=
CORS_ALLOWED_ORIGINS=https://your-app.alwaysdata.net

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
